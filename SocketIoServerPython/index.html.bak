<html>
<head>
<title>Chat Room</title>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/3.0.4/socket.io.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
</head>
<body>
<script type="text/javascript">
$(document).ready(function() {

	var socket = io.connect('http://127.0.0.1:55699');
	// var socket = io.connect('http://192.168.88.240:5000');
	// var socket = io.connect('http://192.168.88.221:55699');
	// var socket = io.connect('http://127.0.0.1:55699');
	socket.on('connect', function() {
		socket.send('User has connected!');
	});

	socket.on('message', function(msg) {
		$("#messages").append('<li>'+msg+'</li>');
		console.log('Received message');
	});

	socket.on('wallpaper', function(msg) {
		$("#messages").append('<li style="color:red;">'+msg.data+'</li>');
		console.log('wallpaper');
	});
	socket.on('key', function(msg) {
		$("#messages").append('<li style="color:red;">'+msg.data+'</li>');
		console.log('key');
	});


	$('#sendbutton').on('click', function() {
		socket.send($('#myMessage').val());
		$('#myMessage').val('');
	});

	$('#wp').on('click', function() {
		socket.emit('wallpaper', {data:$('#myMessage').val()});
		$('#myMessage').val('');
	});
	
	$('#key').on('click', function() {
	socket.emit('key', {data:$('#myMessage').val()});
	$('#myMessage').val('');
	});


});
</script>
<ul id="messages"></ul>
<input type="text" id="myMessage">
<button id="sendbutton">Send</button>
<button id="wp">WP</button>
<button id="key">KEY</button>
</body>
</html>