FROM mcr.microsoft.com/dotnet/sdk:8.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv nodejs npm \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
WORKDIR /src/SocketIoServerPython
RUN python3 -m pip install --break-system-packages -r requirements.txt pytest
WORKDIR /src/SocketIoNodejs
RUN npm ci || npm install
WORKDIR /src
CMD ["bash", "docker/run-ci.sh"]
